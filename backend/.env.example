# Copy to .env for local development. Never commit the real .env.

# --- Required for the content pipeline ---
GEMINI_API_KEY=
YOUTUBE_API_KEY=
# Gemini model used for scoring
GEMINI_MODEL=gemini-3.5-flash

# --- Admin dashboard (/admin) ---
# Sign-in for /admin. These two are all you need.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: a bearer token for scripts/curl. When unset, the session signing key
# is derived from the credentials above (changing the password signs everyone out).
ADMIN_TOKEN=
# How long a browser session lasts before re-login (default 12)
ADMIN_SESSION_HOURS=12

# --- Database ---
# Unset = local SQLite file. Set to a Postgres URL in deployment.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# SQLITE_PATH=./sql_app_v2.db

# --- API server ---
# Comma-separated allowed browser origins ("*" for local dev)
ALLOWED_ORIGINS=*
# Set to 1 to run the hourly scheduler inside the API process
RUN_SCHEDULER=0

# --- Publishing slots ---
# When a new pick goes live: local hours (comma separated) in SLOT_TIMEZONE.
# The default is 6am, 12pm, 6pm and midnight US Eastern. Avoid 2am local,
# which does not exist (or exists twice) on daylight-saving changes.
SLOT_TIMEZONE=America/New_York
SLOT_HOURS=0,6,12,18

# --- Scheduling / metrics ---
PIPELINE_EVERY_HOURS=6
OUTCOME_CHECK_DAYS=7

# Set to 1 to allow fake AI scores when GEMINI_API_KEY is absent (local testing only)
ALLOW_MOCK_SCORING=0
