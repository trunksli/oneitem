# Copy to .env for local development. Never commit the real .env.

# --- Required for the content pipeline ---
GEMINI_API_KEY=
YOUTUBE_API_KEY=
# Gemini model used for scoring
GEMINI_MODEL=gemini-3.5-flash

# --- Admin dashboard (/admin) ---
# Any long random string; sent by the admin page as the X-Admin-Token header.
# Admin endpoints are disabled entirely when this is unset.
ADMIN_TOKEN=

# --- Database ---
# Unset = local SQLite file. Set to a Postgres URL in deployment.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# SQLITE_PATH=./sql_app_v2.db

# --- API server ---
# Comma-separated allowed browser origins ("*" for local dev)
ALLOWED_ORIGINS=*
# Set to 1 to run the hourly scheduler inside the API process
RUN_SCHEDULER=0

# --- Scheduling / metrics ---
PIPELINE_EVERY_HOURS=6
OUTCOME_CHECK_DAYS=7

# Set to 1 to allow fake AI scores when GEMINI_API_KEY is absent (local testing only)
ALLOW_MOCK_SCORING=0
